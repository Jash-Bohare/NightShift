# ===== Nightshift — copy to .env (server/buyer/scripts) and web/.env.local (NEXT_PUBLIC_* only) =====
# Never commit real values.

# ---- General
NODE_ENV=development
PUBLIC_SERVER_URL=http://localhost:8787
PUBLIC_WEB_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
SECRETS_MASTER_KEY=            # 32-byte hex: openssl rand -hex 32
NIGHTSHIFT_QUOTE_SIGNING_PRIVATE_KEY= # base64 PKCS#8 Ed25519 private key; server only
NIGHTSHIFT_QUOTE_VERIFY_PUBLIC_KEY=   # base64 SPKI Ed25519 public key; safe to share with buyer

# ---- 0G Compute Router
ZG_ROUTER_URL=https://router-api.0g.ai/v1          # testnet: https://router-api-testnet.integratenetwork.work/v1
ZG_TEAM_SK_KEY=                # sk-... (team credits) used by spikes, seed agents
ZG_TEAM_MK_KEY=                # mk-... with account:read (balance/usage)
ZG_WHISPER_MODEL=whisper-large-v3                   # verified via GET /v1/models
ZG_CHAT_MODEL=qwen-flash                            # verified via GET /v1/models
BUYER_ZG_SK_KEY=               # buyer agent's own key for its LLM rationale

# Testnet Router keys (testnet Router lists no Whisper; kept for chat-only checks)
ZG_TESTNET_ROUTER_URL=https://router-api-testnet.integratenetwork.work/v1
ZG_TESTNET_SK_KEY=
ZG_TESTNET_MK_KEY=

# ---- Privy (own Nightshift app; allowed origin http://localhost:3000)
PRIVY_APP_ID=
PRIVY_APP_SECRET=              # server only (token verification via @privy-io/node)
PRIVY_JWT_VERIFICATION_KEY=    # optional PEM (SPKI) from the Privy dashboard, one line with \n escapes; verifies tokens locally
BUYER_CONSOLE_ALLOWED_PRIVY_USER_IDS= # comma-separated did:privy:* user IDs authorized for paid console runs

# ---- Hedera testnet
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.
HEDERA_OPERATOR_KEY=           # ECDSA, 0x-prefixed
HEDERA_USDC_TOKEN_ID=0.0.429274
HEDERA_HCS_TOPIC_ID=0.0.
TREASURY_ACCOUNT_ID=0.0.
TREASURY_PRIVATE_KEY=          # ECDSA, 0x-prefixed (created by scripts/spikes/hedera.ts)
# x402 spike payee (scripts/spikes/x402-*.ts only)
SPIKE_SELLER_ACCOUNT_ID=0.0.
SPIKE_SELLER_PRIVATE_KEY=
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
X402_FACILITATOR_URL=https://x402.org/facilitator   # fallback: https://api.testnet.blocky402.com
PAYOUTS_ENABLED=false                              # keep false until payout deployment is explicitly approved
BUYER_CONSOLE_ENABLED=false                       # set true only on an access-controlled test instance; endpoint can spend test USDC
CRONS_ENABLED=false                               # indexer, reputation (Sepolia writes), settlement recovery. Opt-in; PAYOUTS_ENABLED requires it
OWNER_LAUNCH_ENABLED=false                        # POST /me/agents self-service launch (spends operator Sepolia gas + 2 HBAR per launch). Needs PRIVY_APP_ID/SECRET
OWNER_MAX_AGENTS=3                                # workers per owner account (failed launches do not count)
HCS_SUBMIT_ENABLED=true                           # job log to HCS (spends operator HBAR); false for QA environments
NIGHTSHIFT_SIMULATION=false                       # local QA only (in-memory DB, loopback facilitator/0G). Refused in production. Use `pnpm -C server dev:simulated`
TRUST_PROXY_HOPS=0                                # reverse-proxy hops to trust for client IPs (rate limits); 0 = no proxy
UPLOAD_MAX_PER_MINUTE=8                           # paid-run uploads per client per minute
UPLOAD_MAX_CONCURRENT_PER_CLIENT=2
UPLOAD_MAX_CONCURRENT_TOTAL=8
WORKER_REQUESTS_PER_MINUTE=60                     # /a/:label/quote and /a/:label/run per client per minute

# ---- Buyer agent (demo)
BUYER_HEDERA_ACCOUNT_ID=0.0.
BUYER_HEDERA_PRIVATE_KEY=      # ECDSA, 0x-prefixed; associated with USDC, funded via faucet.circle.com
BUYER_SERVER_URL=http://localhost:8787

# ---- Sepolia / ENSv2
SEPOLIA_RPC_URL=
SEPOLIA_LOGS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com   # indexer log scans (Alchemy free tier caps getLogs ranges)
DEPLOYER_PRIVATE_KEY=          # admin + owner of nightshift.eth
ENS_OPERATOR_PRIVATE_KEY=      # registrar operator (server hot key)
ETHERSCAN_API_KEY=
ENS_PARENT_NAME=nightshift.eth
ENS_USER_REGISTRY_ADDRESS=       # our UserRegistry for nightshift.eth (scripts/spikes/ens.ts)
ENS_HELLO_RESOLVER_ADDRESS=      # spike only
SMOKE_OWNER_PRIVATE_KEY=         # P1.6 smoke-test agent owner (contracts/script/smoke.sh)
SMOKE_OWNER_ADDRESS=
SEPOLIA_DRIP_WEI=3000000000000000   # 0.003 ETH gas drip to launching owners below 0.002 ETH (0 disables)

# ---- Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # server only

# Supabase CLI (link + db push without a browser login)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# ---- Web (web/.env.local)
NEXT_PUBLIC_SERVER_URL=http://localhost:8787
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ENS_PARENT_NAME=nightshift.eth
NEXT_PUBLIC_NIGHTSHIFT_REGISTRAR_ADDRESS=0x9564fFd96FBaA1bF10836966990aCc88a9865705
NEXT_PUBLIC_HEDERA_HCS_TOPIC_ID=0.0.11129931
NEXT_PUBLIC_DEMO_MODE=false        # true only for the hosted build: hides sign-in, launch, dashboard and paid console runs
