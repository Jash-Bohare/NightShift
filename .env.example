# ===== Nightshift — copy to .env (server/buyer/scripts) and web/.env.local (NEXT_PUBLIC_* only) =====
# Never commit real values.

# ---- General
NODE_ENV=development
PUBLIC_SERVER_URL=http://localhost:8787
PUBLIC_WEB_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
SECRETS_MASTER_KEY=            # 32-byte hex: openssl rand -hex 32

# ---- 0G Compute Router
ZG_ROUTER_URL=https://router-api.0g.ai/v1          # testnet: https://router-api-testnet.integratenetwork.work/v1
ZG_TEAM_SK_KEY=                # sk-... (team credits) used by spikes, seed agents
ZG_TEAM_MK_KEY=                # mk-... with account:read (balance/usage)
ZG_WHISPER_MODEL=whisper-large-v3                   # verified via GET /v1/models
ZG_CHAT_MODEL=qwen-flash                            # verified via GET /v1/models
BUYER_ZG_SK_KEY=               # buyer agent's own key for its LLM rationale

# Testnet Router keys (testnet Router lists no Whisper; kept for chat-only checks)
ZG_TESTNET_ROUTER_URL=https://router-api-testnet.integratenetwork.work/v1
ZG_TESTNET_SK_KEY=
ZG_TESTNET_MK_KEY=

# ---- Privy (own Nightshift app; allowed origin http://localhost:3000)
PRIVY_APP_ID=
PRIVY_APP_SECRET=              # server only (token verification via @privy-io/node)

# ---- Hedera testnet
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.
HEDERA_OPERATOR_KEY=           # ECDSA, 0x-prefixed
HEDERA_USDC_TOKEN_ID=0.0.429274
HEDERA_HCS_TOPIC_ID=0.0.
TREASURY_ACCOUNT_ID=0.0.
TREASURY_PRIVATE_KEY=          # ECDSA, 0x-prefixed (created by scripts/spikes/hedera.ts)
# x402 spike payee (scripts/spikes/x402-*.ts only)
SPIKE_SELLER_ACCOUNT_ID=0.0.
SPIKE_SELLER_PRIVATE_KEY=
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
X402_FACILITATOR_URL=https://x402.org/facilitator   # fallback: https://api.testnet.blocky402.com

# ---- Buyer agent (demo)
BUYER_HEDERA_ACCOUNT_ID=0.0.
BUYER_HEDERA_PRIVATE_KEY=      # ECDSA, 0x-prefixed; associated with USDC, funded via faucet.circle.com
BUYER_SERVER_URL=http://localhost:8787

# ---- Sepolia / ENSv2
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=          # admin + owner of nightshift.eth
ENS_OPERATOR_PRIVATE_KEY=      # registrar operator (server hot key)
ETHERSCAN_API_KEY=
ENS_PARENT_NAME=nightshift.eth
ENS_USER_REGISTRY_ADDRESS=       # our UserRegistry for nightshift.eth (scripts/spikes/ens.ts)
ENS_HELLO_RESOLVER_ADDRESS=      # spike only
SMOKE_OWNER_PRIVATE_KEY=         # P1.6 smoke-test agent owner (contracts/script/smoke.sh)
SMOKE_OWNER_ADDRESS=
SEPOLIA_DRIP_WEI=3000000000000000   # 0.003 ETH gas drip to new owners

# ---- Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # server only

# Supabase CLI (link + db push without a browser login)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# ---- Web (web/.env.local)
NEXT_PUBLIC_SERVER_URL=http://localhost:8787
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ENS_PARENT_NAME=nightshift.eth
NEXT_PUBLIC_DEMO_MODE=false
